lfs# Git LFS attribute presets
[attr]lock filter=lfs diff=lfs merge=binary -text lockable
[attr]lockonly lockable
[attr]lfs filter=lfs diff=lfs merge=binary -text
[attr]lfstext filter=lfs diff=lfstext merge=lfstext -text

# Unreal Engine binary asset files - use LFS and lockable
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

# Unreal Engine legacy / additional asset files
*.upk lfs
*.uiasset lfs

# Unreal Engine text/config files
*.ini text
*.uproject text
*.uplugin text

# 3D source files
*.obj lfs
*.fbx lfs

# Audio files
